<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/topic_input" />
            <stroke android:width="2dp" android:color="@color/topic_active" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/topic_input" />
            <stroke android:width="1dp" android:color="@color/topic_border" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
