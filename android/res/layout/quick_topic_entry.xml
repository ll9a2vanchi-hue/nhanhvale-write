<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingBottom="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/quick_topic_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/topic_heading"
                android:textColor="@color/topic_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/close_topic_entry"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/topic_close"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="×"
                android:textColor="@color/topic_secondary"
                android:textSize="25sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/topic_entry_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/quick_topic_field"
                android:hint="@string/topic_hint"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textCapSentences"
                android:maxLength="240"
                android:minHeight="50dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:singleLine="true"
                android:textColor="@color/topic_text"
                android:textColorHint="@color/topic_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/save_topic_entry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/quick_topic_save"
                android:minHeight="50dp"
                android:minWidth="60dp"
                android:paddingHorizontal="12dp"
                android:text="@string/topic_save"
                android:textAllCaps="false"
                android:textColor="@color/topic_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
